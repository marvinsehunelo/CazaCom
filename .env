# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_URL=https://cazacom-production.up.railway.app

# Saccussalis API Configuration
SACCUSSALIS_API_URL=https://saccussalis.com
SACCUSSALIS_API_KEY=SACCUS_INTERNAL_KEY_2025
SACCUSSALIS_API_TOKEN=your_bearer_token_here

# Database Configuration (Railway PostgreSQL)
# These will be auto-set by Railway, but you can override
PG_HOST=${PGHOST}
PG_PORT=${PGPORT}
PG_NAME=${PGDATABASE}
PG_USER=${PGUSER}
PG_PASS=${PGPASSWORD}
DATABASE_URL=${DATABASE_URL}

# SMS Gateway (if used)
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=CAZACOM

# Fee Configuration
TRANSFER_FEE_PERCENT=1.5
CASHOUT_FEE=5.00

# Security
JWT_SECRET=${JWT_SECRET:-cazacom_jwt_secret_2025}
ENCRYPTION_KEY=${ENCRYPTION_KEY:-cazacom_encryption_key_32_chars}
